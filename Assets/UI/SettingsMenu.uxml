<ui:UXML xmlns:ui="UnityEngine.UIElements"><ui:Style src="MenuFont.uss"/><ui:Style src="SettingsMenu.uss"/><ui:VisualElement class="settings-root"><ui:VisualElement class="settings-panel"><ui:Label text="SETTINGS" class="settings-title"/><ui:Label text="AUDIO" class="section-title"/><ui:VisualElement class="settings-divider"/><ui:VisualElement class="setting-row"><ui:Label text="MASTER VOLUME" class="setting-label"/><ui:VisualElement class="slider-art"><ui:VisualElement class="slider-track"/><ui:VisualElement class="slider-knob knob-high"/></ui:VisualElement></ui:VisualElement><ui:VisualElement class="setting-row"><ui:Label text="MUSIC" class="setting-label"/><ui:VisualElement class="slider-art"><ui:VisualElement class="slider-track"/><ui:VisualElement class="slider-knob knob-mid"/></ui:VisualElement></ui:VisualElement><ui:VisualElement class="setting-row"><ui:Label text="SFX" class="setting-label"/><ui:VisualElement class="slider-art"><ui:VisualElement class="slider-track"/><ui:VisualElement class="slider-knob knob-low"/></ui:VisualElement></ui:VisualElement><ui:Label text="DISPLAY &amp; CONTROLS" class="section-title section-title-lower"/><ui:VisualElement class="settings-divider"/><ui:VisualElement class="setting-row"><ui:Label text="FULLSCREEN" class="setting-label"/><ui:VisualElement class="toggle-art toggle-on"/></ui:VisualElement><ui:VisualElement class="setting-row"><ui:Label text="SCREEN SHAKE" class="setting-label"/><ui:VisualElement class="toggle-art toggle-off"/></ui:VisualElement><ui:VisualElement class="setting-row"><ui:Label text="RESOLUTION" class="setting-label"/><ui:VisualElement class="resolution-art"><ui:VisualElement class="arrow-art arrow-left"/><ui:Label text="1920 x 1080" class="resolution-label"/><ui:VisualElement class="arrow-art arrow-right"/></ui:VisualElement></ui:VisualElement><ui:VisualElement class="settings-footer"><ui:VisualElement class="back-button-art"><ui:Label text="BACK" class="back-button-text"/></ui:VisualElement><ui:Label t