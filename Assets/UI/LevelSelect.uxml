<ui:UXML xmlns:ui="UnityEngine.UIElements"><ui:Style src="MenuFont.uss"/><ui:Style src="LevelSelect.uss"/><ui:Style src="LevelSelectOverrides.uss"/><ui:VisualElement class="level-select-overlay"><ui:Label text="SELECT LEVEL" class="level-select-title"/><ui:VisualElement class="level-select-content"><ui:VisualElement class="level-list-panel"><ui:Label text="LEVELS" class="level-list-heading"/><ui:Button name="ScrollUpButton" text="▲" class="level-scroll-button level-scroll-up"/><ui:ScrollView name="LevelScrollView" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="level-scroll-view"><ui:Button name="LevelOneButton" text="01   THE BEGINNING" class="level-entry level-entry-selected"/><ui:Button name="LevelTwoButton" text="02   THE OUTSKIRTS" class="level-entry"/><ui:Button name="LevelThreeButton" text="03   THE CROSSING" class="level-entry"/><ui:Button name="LevelFourButton" text="04   THE DESCENT" class="level-entry"/><ui:Button name="LevelFiveButton" text="05   COMING SOON" class="level-entry"/><ui:Button name="LevelSixButton" text="06   COMING SOON" class="level-entry"/><ui:Button name="LevelSevenButton" text="07   COMING SOON" class="level-entry"/></ui:ScrollView><ui:Button name="ScrollDownButton" text="▼" class="level-scroll-button level-scroll-down"/><ui:VisualElement class="level-list-footer"><ui:Button name="BackButton" text="BACK" class="level-back-button"/></ui:VisualElement></ui:VisualElement><ui:VisualElement class="level-preview-panel"><ui:Label text="THE BEGINNING" class="level-preview-heading"/><ui:VisualElement class="level-preview-frame"><ui:Label text="LEVEL PREVIEW" class="level-preview-placeholder"/></ui:VisualElement><ui:Label text="Your journey begins here. Select a level to enter the world of Zero Tolerance." class="level-description"/></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:UXML>