.hud-root { position: absolute; left: 24px; top: 22px; align-items: flex-start; }
.coin-counter { width: 240px; height: 82px; padding-left: 0; padding-right: 0; flex-direction: row; align-items: center; justify-content: center; background-image: url("project://database/Assets/Sprites/UI/Health_Hud.png?fileID=763991195102037128&guid=94f6ce30ea74cba4ba90428ca37c1dbb&type=3#Health_Hud_8"); -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: rgba(255, 255, 255, 0.6); }
.coin-icon { width: 36px; height: 36px; margin-left: 0; margin-right: 10px; background-image: url("project://database/Assets/Sprites/Pickups/Power_UP_Icons.png?fileID=-335664467&guid=5a385dffef7fe4740a3e5c1d73e44db7&type=3#Gold_Coin_Sprite"); -unity-background-scale-mode: scale-to-fit; }
.coin-count { color: rgb(255, 255, 255); font-size: 31px; -unity-font-style: bold; letter-spacing: 2px; }
.heart-row { width: 240px; margin-top: 9px; flex-direction: row; align-items: center; justify-content: center; }
.heart-icon { width: 58px; height: 58px; margin-right: 7px; background-image: url("project://database/Assets/Sprites/UI/Health_Hud.png?fileID=-6313528471704947012&guid=94f6ce30ea74cba4ba90428ca37c1dbb&type=3#Health_Hud_3"); -unity-background-scale-mode: scale-to-fit; }
.heart-icon-last { margin-right: 0; }
.inventory-open-button { width: 120px; height: 42px; margin-top: 12px; color: rgb(255,248,234); font-size: 18px; -unity-font-style: bold; background-image: url("project://database/Assets/Sprites/UI/UI buttons.png?fileID=-6188929701681851848&guid=c2b6350590f86ca478d89e4a4b188bd9&type=3#Big_Long_Button"); -unity-background-scale-mode: scale-to-fit; background-color: rgba(0,0,0,0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.inventory-open-button:hover { color: rgb(255,216,166); -unity-background-image-tint-color: rgb(224,178,122); }