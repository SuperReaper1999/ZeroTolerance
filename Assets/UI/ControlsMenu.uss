.controls-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 10, 17, 0.86); }
.controls-frame { width: 900px; padding-left: 38px; padding-right: 38px; padding-top: 26px; padding-bottom: 24px; background-color: rgb(4, 20, 31); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgb(142, 86, 31); border-right-color: rgb(142, 86, 31); border-top-color: rgb(142, 86, 31); border-bottom-color: rgb(142, 86, 31); }
.controls-title { align-self: center; color: rgb(255, 247, 232); font-size: 50px; -unity-font-style: bold; letter-spacing: 5px; }
.controls-subtitle { align-self: center; margin-top: 2px; color: rgb(235, 170, 94); font-size: 22px; -unity-font-style: bold; letter-spacing: 3px; }
.controls-divider { height: 2px; margin-top: 12px; margin-bottom: 10px; background-color: rgb(150, 89, 29); }
.bindings-header { height: 40px; padding-left: 24px; padding-right: 14px; flex-direction: row; align-items: center; background-color: rgb(154, 111, 61); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(224, 177, 106); border-right-color: rgb(224, 177, 106); border-top-color: rgb(224, 177, 106); border-bottom-color: rgb(224, 177, 106); }
.header-action { width: 42%; color: rgb(37, 24, 14); font-size: 19px; -unity-font-style: bold; }
.header-key { flex-grow: 1; color: rgb(37, 24, 14); font-size: 19px; -unity-font-style: bold; -unity-text-align: middle-center; }
.header-reset { width: 64px; color: rgb(37, 24, 14); font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; }
.bindings-scroll { height: 258px; margin-top: 3px; margin-bottom: 12px; background-color: rgb(121, 83, 43); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(222, 170, 96); border-right-color: rgb(222, 170, 96); border-top-color: rgb(222, 170, 96); border-bottom-color: rgb(222, 170, 96); }
.binding-row { height: 76px; min-height: 76px; margin-left: 8px; margin-right: 8px; padding-left: 17px; padding-right: 10px; flex-direction: row; align-items: center; background-color: rgb(176, 132, 77); border-bottom-width: 2px; border-bottom-color: rgb(61, 39, 20); }
.binding-action { width: 42%; color: rgb(42, 28, 15); font-size: 23px; -unity-font-style: bold; letter-spacing: 1px; }
Button.binding-key { width: 250px; height: 62px; color: rgb(255, 244, 225); font-size: 22px; -unity-font-style: bold; letter-spacing: 2px; background-image: url("project://database/Assets/Sprites/UI/UI buttons.png?fileID=-6188929701681851848&guid=c2b6350590f86ca478d89e4a4b188bd9&type=3#Big_Long_Button"); -unity-background-scale-mode: scale-to-fit; background-color: rgba(0,0,0,0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
Button.binding-key:hover { color: rgb(255,216,166); -unity-background-image-tint-color: rgb(224,178,122); }
Button.binding-reset { width: 54px; height: 54px; margin-left: 12px; color: rgb(255, 232, 191); font-size: 27px; -unity-font-style: bold; background-image: url("project://database/Assets/Sprites/UI/UI buttons.png?fileID=5429045347840414981&guid=c2b6350590f86ca478d89e4a4b188bd9&type=3#Small_Fabric_Button"); -unity-background-scale-mode: scale-to-fit; background-color: rgba(0,0,0,0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
Button.binding-reset:hover { color: rgb(255,183,105); -unity-background-image-tint-color: rgb(229,179,112); }
.rebind-status-panel { min-height: 74px; padding-left: 20px; padding-right: 20px; padding-top: 8px; padding-bottom: 8px; align-items: center; justify-content: center; background-color: rgb(28, 22, 16); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(137,82,28); border-right-color: rgb(137,82,28); border-top-color: rgb(137,82,28); border-bottom-color: rgb(137,82,28); }
.rebind-status { color: rgb(255,215,160); font-size: 20px; -unity-font-style: bold; letter-spacing: 1px; }
.rebind-help { margin-top: 2px; color: rgb(217,194,163); font-size: 15px; }
.controls-footer { margin-top: 16px; flex-direction: row; justify-content: space-between; }
Button.controls-footer-button { width: 260px; height: 70px; color: rgb(255,248,234); font-size: 21px; -unity-font-style: bold; letter-spacing: 2px; background-image: url("project://database/Assets/Sprites/UI/UI buttons.png?fileID=-6188929701681851848&guid=c2b6350590f86ca478d89e4a4b188bd9&type=3#Big_Long_Button"); -unity-background-scale-mode: scale-to-fit; background-color: rgba(0,0,0,0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
Button.controls-footer-button:hover { color: rgb(255,216,166); -unity-background-image-tint-color: rgb(224,178,122); }
Button.controls-reset-all { width: 300px; }
