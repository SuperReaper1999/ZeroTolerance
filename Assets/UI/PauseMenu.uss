.pause-overlay{position:absolute;left:0;right:0;top:0;bottom:0;align-items:center;justify-content:center;background-color:rgba(4,12,20,.78)}.pause-panel{width:360px;align-items:center}.pause-title{color:rgb(248,245,238);font-size:38px;-unity-font-style:bold;letter-spacing:5px;-unity-text-align:middle-center}.title-divider{display:none}.menu-options{width:260px;align-items:stretch}Button.menu-button{height:72px;margin-bottom:2px;padding-left:0;padding-right:0;padding-top:0;padding-bottom:0;color:rgb(244,241,234);font-size:18px;-unity-font-style:bold;letter-spacing:2px;-unity-text-align:middle-center;background-color:rgba(255,255,255,0);background-image:url("project://database/Assets/Sprites/UI/UI buttons.png?fileID=-6188929701681851848&guid=c2b6350590f86ca478d89e4a4b188bd9&type=3#Big_Long_Button");-unity-background-scale-mode:scale-to-fit;-unity-background-image-tint-color:rgb(255,255,255);border-left-width:0;border-right-width:0;border-top-width:0;border-bottom-width:0;border-top-left-radius:0;border-top-right-radius:0;border-bottom-left-radius:0;border-bottom-right-radius:0}Button.menu-button:hover{color:rgb(255,216,166);-unity-background-image-tint-color:rgb(224,178,122);background-color:rgba(255,255,255,0)}.back-row{margin-top:7px;flex-direction:row;align-items:center;justify-content:center}.keycap{color:rgb(234,231,225);font-size:12px;-unity-font-style:bold;padding-left:6px;padding-right:6px;padding-top:4px;padding-bottom:4px;border-left-width:2px;border-right-width:2px;border-top-width:2px;border-bottom-width:2px;border-left-color:rgb(120,125,124);border-right-color:rgb(120,125,124);border-top-color:rgb(120,125,124);border-bottom-color:rgb(120,125,124);background-color:rgba(45,48,48,.92)}.back-label{color:rgb(221,218,211);font-size:14px;-unity-font-style:bold;letter-spacing:2px;margin-left:11px}