.settings-root { flex-grow: 1; align-items: center; justify-content: center; background-color: rgb(2, 13, 22); color: rgb(244, 241, 234); } .settings-panel { width: 700px; padding: 20px 46px 18px 46px; background-color: rgba(5, 22, 34, 0.92); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(135, 78, 26); border-right-color: rgb(135, 78, 26); border-top-color: rgb(135, 78, 26); border-bottom-color: rgb(135, 78, 26); } .settings-title { align-self: center; font-size: 46px; color: rgb(255, 248, 235); -unity-font-style: bold; margin-bottom: 12px; flex-shrink: 0; } .section-title { font-size: 21px; color: rgb(235, 170, 94); -unity-font-style: bold; margin-top: 2px; flex-shrink: 0; } .section-title-lower { margin-top: 16px; } .settings-divider { height: 2px; margin-top: 5px; margin-bottom: 8px; background-color: rgb(135, 78, 26); flex-shrink: 0; } .setting-row { height: 54px; min-height: 54px; flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; } .setting-label { width: 210px; font-size: 19px; color: rgb(244, 226, 198); } .slider-art { width: 355px; height: 46px; position: relative; } .slider-track { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-image: url("project://database/Assets/Sprites/UI/SettingsControlsSpriteSheet.png?fileID=-1536049016&guid=8a848ebdb82e4de49bf7822aa484e570&type=3#SettingsSliderTrack"); -unity-background-scale-mode: scale-to-fit; } .slider-knob { position: absolute; top: 6px; width: 34px; height: 34px; background-image: url("project://database/Assets/Sprites/UI/SettingsControlsSpriteSheet.png?fileID=-1527703579&guid=8a848ebdb82e4de49bf7822aa484e570&type=3#SettingsSliderKnob"); -unity-background-scale-mode: scale-to-fit; } .toggle-art { width: 96px; height: 46px; -unity-background-scale-mode: scale-to-fit; } .toggle-on { background-image: url("project://database/Assets/Sprites/UI/SettingsControlsSpriteSheet.png?fileID=851766107&guid=8a848ebdb82e4de49bf7822aa484e570&type=3#SettingsToggleOn"); } .toggle-off { background-image: url("project://database/Assets/Sprites/UI/SettingsControlsSpriteSheet.png?fileID=333386642&guid=8a848ebdb82e4de49bf7822aa484e570&type=3#SettingsToggleOff"); } .resolution-art { width: 235px; height: 42px; flex-direction: row; align-items: center; justify-content: space-between; } .arrow-art { width: 34px; height: 40px; -unity-background-scale-mode: scale-to-fit; } .arrow-left { background-image: url("project://database/Assets/Sprites/UI/SettingsControlsSpriteSheet.png?fileID=18488506&guid=8a848ebdb82e4de49bf7822aa484e570&type=3#SettingsArrowLeft"); } .arrow-right { background-image: url("project://database/Assets/Sprites/UI/SettingsControlsSpriteSheet.png?fileID=-826681923&guid=8a848ebdb82e4de49bf7822aa484e570&type=3#SettingsArrowRight"); } .resolution-label { font-size: 18px; color: rgb(244, 226, 198); } .settings-footer { margin-top: 14px; align-items: center; flex-shrink: 0; } .back-button-art { width: 210px; height: 58px; align-items: center; justify-content: center; background-image: url("project://database/Assets/Sprites/UI/UI buttons.png?fileID=-6188929701681851848&guid=c2b6350590f86ca478d89e4a4b188bd9&type=3#Big_Long_Button"); -unity-background-scale-mode: scale-to-fit; } .back-button-text { font-size: 21px; color: rgb(255, 248, 235); -unity-font-style: bold; } .footer-note { margin-top: 6px; font-size: 13px; color: rgb(185, 151, 111); } Button.toggle-art, Button.arrow-art, Button.back-button-art { background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; }