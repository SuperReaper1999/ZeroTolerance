<ui:UXML xmlns:ui="UnityEngine.UIElements"><ui:Style src="MenuFont.uss"/><ui:Style src="QuestUI.uss"/><ui:VisualElement name="QuestJournalOverlay" class="quest-overlay"><ui:VisualElement class="quest-frame"><ui:Label text="QUEST JOURNAL" class="quest-title"/><ui:Label text="MISSIONS AND OBJECTIVES" class="quest-subtitle"/><ui:VisualElement class="quest-divider"/><ui:VisualElement class="quest-body"><ui:VisualElement class="quest-list-pane"><ui:Label text="QUESTS" class="quest-section-title"/><ui:ScrollView name="QuestListScroll" class="quest-list" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden"><ui:Button name="QuestRow0" text="NO ACTIVE QUESTS" class="quest-row"/><ui:Button name="QuestRow1" text="" class="quest-row"/><ui:Button name="QuestRow2" text="" class="quest-row"/><ui:Button name="QuestRow3" text="" class="quest-row"/><ui:Button name="QuestRow4" text="" class="quest-row"/><ui:Button name="QuestRow5" text="" class="quest-row"/><ui:Button name="QuestRow6" text="" class="quest-row"/><ui:Button name="QuestRow7" text="" class="quest-row"/></ui:ScrollView></ui:VisualElement><ui:VisualElement class="quest-detail-pane"><ui:Label name="QuestTitleLabel" text="SELECT A QUEST" class="quest-detail-title"/><ui:Label name="QuestMetaLabel" text="" class="quest-detail-meta"/><ui:Label name="QuestDescriptionLabel" text="Choose a quest to inspect its current objective and tracked destination." class="quest-detail-description"/><ui:Label text="OBJECTIVES" class="quest-objectives-title"/><ui:Label name="QuestObjectivesLabel" text="" class="quest-objectives"/><ui:VisualElement class="quest-map"><ui:Label name="QuestMapLabel" text="NO TRACKED DESTINATION" class="quest-map-label"/></ui:VisualElement></ui:VisualElement></ui:VisualElement><ui:VisualElement class="quest-footer"><ui:Button name="QuestCloseButton" text="BACK" class="quest-big-button"/><ui:Button name="QuestTrackButton" text="TRACK QUEST" class="quest-big-button"/></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:UXML>