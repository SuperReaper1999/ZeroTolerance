.level-select-overlay { position:absolute; left:0; right:0; top:0; bottom:0; padding-left:56px; padding-right:56px; padding-top:42px; padding-bottom:24px; background-color:rgb(4,12,20); }
.level-select-title { align-self:center; color:rgb(248,245,238); font-size:42px; -unity-font-style:bold; letter-spacing:6px; -unity-text-align:middle-center; }
.level-select-content { flex-grow:1; margin-top:18px; flex-direction:row; align-items:flex-start; justify-content:center; }
.level-list-panel { width:320px; margin-right:48px; align-items:center; }
.level-list-heading, .level-preview-heading { color:rgb(255,216,166); font-size:22px; -unity-font-style:bold; letter-spacing:3px; margin-bottom:7px; }
.level-scroll-button { width:34px; height:34px; margin-bottom:4px; padding-left:0; padding-right:0; padding-top:0; padding-bottom:0; color:rgb(255,216,166); font-size:18px; -unity-font-style:bold; -unity-text-align:middle-center; background-color:rgba(255,255,255,0); -unity-background-scale-mode:scale-to-fit; border-left-width:0; border-right-width:0; border-top-width:0; border-bottom-width:0; }
.level-scroll-up { background-image:url("project://database/Assets/Sprites/UI/UI buttons.png?fileID=5429045347840414981&guid=c2b6350590f86ca478d89e4a4b188bd9&type=3#Small_Fabric_Button"); }
.level-scroll-down { margin-top:4px; margin-bottom:7px; background-image:url("project://database/Assets/Sprites/UI/UI buttons.png?fileID=-6840539209906488085&guid=c2b6350590f86ca478d89e4a4b188bd9&type=3#Small_Moss_Button"); }
.level-scroll-view { width:320px; height:230px; }
.level-scroll-view .unity-scroll-view__vertical-scroller { display:none; }
.level-scroll-view .unity-scroller { display:none; }
Button.level-entry { height:54px; margin-bottom:3px; padding-left:17px; padding-right:17px; padding-top:0; padding-bottom:0; flex-direction:row; align-items:center; color:rgb(244,241,234); font-size:17px; -unity-font-style:bold; letter-spacing:2px; background-color:rgba(255,255,255,0); background-image:url("project://database/Assets/Sprites/UI/UI buttons.png?fileID=-6188929701681851848&guid=c2b6350590f86ca478d89e4a4b188bd9&type=3#Big_Long_Button"); -unity-background-scale-mode:stretch-to-fill; -unity-background-image-tint-color:rgb(255,255,255); border-left-width:0; border-right-width:0; border-top-width:0; border-bottom-width:0; }
Button.level-entry:hover, Button.level-entry-selected { color:rgb(255,216,166); -unity-background-image-tint-color:rgb(224,178,122); }
.level-number { width:48px; color:rgb(255,216,166); }.level-name { flex-grow:1; }.level-preview-panel { width:470px; }.level-preview-frame { height:270px; align-items:center; justify-content:center; background-color:rgba(13,22,29,.88); border-left-width:2px; border-right-width:2px; border-top-width:2px; border-bottom-width:2px; border-left-color:rgba(178,117,53,.78); border-right-color:rgba(178,117,53,.78); border-top-color:rgba(178,117,53,.78); border-bottom-color:rgba(178,117,53,.78); }.level-preview-placeholder { color:rgba(255,216,166,.55); font-size:20px; -unity-font-style:bold; letter-spacing:3px; }.level-description { color:rgb(221,218,211); font-size:20px; -unity-font-style:bold; letter-spacing:1px; white-space:normal; margin-top:16px; }.level-list-footer { width:260px; }Button.level-back-button { height:58px; padding-left:0; padding-right:0; padding-top:0; padding-bottom:0; color:rgb(244,241,234); font-size:18px; -unity-font-style:bold; letter-spacing:2px; -unity-text-align:middle-center; background-color:rgba(255,255,255,0); background-image:url("project://database/Assets/Sprites/UI/UI buttons.png?fileID=-6188929701681851848&guid=c2b6350590f86ca478d89e4a4b188bd9&type=3#Big_Long_Button"); -unity-background-scale-mode:scale-to-fit; -unity-background-image-tint-color:rgb(255,255,255); border-left-width:0; border-right-width:0; border-top-width:0; border-bottom-width:0; }Button.level-back-button:hover { color:rgb(255,216,166); -unity-background-image-tint-color:rgb(224,178,122); }