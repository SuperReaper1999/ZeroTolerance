<ui:UXML xmlns:ui="UnityEngine.UIElements"><ui:Style src="MenuFont.uss"/><ui:Style src="ControlsMenu.uss"/><ui:VisualElement name="ControlsOverlay" class="controls-overlay"><ui:VisualElement name="ControlsFrame" class="controls-frame"><ui:Label text="CONTROLS" class="controls-title"/><ui:Label text="KEY BINDINGS" class="controls-subtitle"/><ui:VisualElement class="controls-divider"/><ui:VisualElement class="bindings-header"><ui:Label text="ACTION" class="header-action"/><ui:Label text="PRIMARY KEY" class="header-key"/><ui:Label text="RESET" class="header-reset"/></ui:VisualElement><ui:ScrollView name="BindingsScrollView" class="bindings-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden"><ui:VisualElement class="binding-row"><ui:Label text="MOVE LEFT" class="binding-action"/><ui:Button name="MoveLeftButton" text="A" class="binding-key"/><ui:Button name="MoveLeftResetButton" text="↻" class="binding-reset"/></ui:VisualElement><ui:VisualElement class="binding-row"><ui:Label text="MOVE RIGHT" class="binding-action"/><ui:Button name="MoveRightButton" text="D" class="binding-key"/><ui:Button name="MoveRightResetButton" text="↻" class="binding-reset"/></ui:VisualElement><ui:VisualElement class="binding-row"><ui:Label text="JUMP" class="binding-action"/><ui:Button name="JumpButton" text="SPACE" class="binding-key"/><ui:Button name="JumpResetButton" text="↻" class="binding-reset"/></ui:VisualElement></ui:ScrollView><ui:VisualElement class="rebind-status-panel"><ui:Label name="RebindStatusLabel" text="SELECT A BINDING TO REBIND" class="rebind-status"/><ui:Label text="Press a key to assign it. Esc cancels while listening." class="rebind-help"/></ui:VisualElement><ui:VisualElement class="controls-footer"><ui:Button name="ControlsBackButton" text="BACK" class="controls-footer-button"/><ui:Button name="ResetBindingsButton" text="RESET TO DEFAULTS" class="controls-footer-button controls-reset-all"/></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:UXML>